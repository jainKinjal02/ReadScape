{
  "expo": {
    "name": "ReadScape",
    "slug": "readscape",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "readscape",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#F8F4EA"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.readscape.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F8F4EA"
      },
      "package": "com.readscape.app",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "ReadScape uses your photo library so you can add pictures of your books and reading spots to your journal.",
          "cameraPermission": "ReadScape uses the camera so you can photograph a book or your reading spot and save it to your journal.",
          "microphonePermission": "ReadScape uses the microphone to record voice notes about the book you're reading, which are transcribed into your mood, quotes and thoughts."
        }
      ],
      "expo-font",
      "expo-asset",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-audio",
        {
          "microphonePermission": "ReadScape uses the microphone to record voice notes about the book you're reading, which are transcribed into your mood, quotes and thoughts."
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.662075810228-qkhgeqr79a93bjd8j49nsuvfkpv1gs4d"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "711923d7-4941-4a42-b042-def05cf2f522"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/711923d7-4941-4a42-b042-def05cf2f522"
    }
  }
}
